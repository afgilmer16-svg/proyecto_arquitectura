<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pe.abc</groupId>
  <artifactId>facturacion-xml</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <developers>
    <developer>
      <name>Gilmer Ayala Falcón</name>
      <organization>UNAS-FIIS · Arquitectura de Software · Grupo A</organization>
    </developer>
  </developers>
  <name>ABC Software Corp - generador del XML UBL 2.1 (Invoice)</name>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Carpeta unica con los XSD oficiales del repositorio. -->
    <dir.xsd.oficial>${project.basedir}/../docs/referencias/ubl</dir.xsd.oficial>
    <!-- Copia temporal con la forma maindoc/ + common/ que usan los schemaLocation del XSD. -->
    <dir.xsd.compilacion>${project.build.directory}/ubl-compilacion</dir.xsd.compilacion>
    <cobertura.minima>0.90</cobertura.minima>
  </properties>

  <dependencies>
    <!-- XML <-> objetos Java (clases generadas desde el XSD) -->
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.5</version>
    </dependency>

    <!-- Lectura del JSON de entrada y su JSON Schema -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>1.5.5</version>
    </dependency>

    <!-- Pruebas -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xmlunit</groupId>
      <artifactId>xmlunit-core</artifactId>
      <version>2.10.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- XSD empaquetados en el jar para validar sin red. -->
      <resource>
        <directory>${dir.xsd.compilacion}</directory>
        <targetPath>ubl</targetPath>
      </resource>
      <!-- El JSON Schema de la entrada es el mismo archivo del repositorio, no una copia. -->
      <resource>
        <directory>${project.basedir}/../specs/schemas</directory>
        <targetPath>schemas</targetPath>
      </resource>
    </resources>

    <plugins>
      <!-- Abrir el formulario web: ver README (comando exec:java con el argumento web y el puerto). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>pe.abc.facturacion.Aplicacion</mainClass>
        </configuration>
      </plugin>

      <!-- Cobertura: el codigo generado por JAXB (oasis, un, org) no cuenta. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <configuration>
          <excludes>
            <exclude>oasis/**/*</exclude>
            <exclude>un/**/*</exclude>
            <exclude>org/**/*</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>agente</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>informe</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>exigir-minimo</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${cobertura.minima}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <!-- Paso 1: dejar los XSD con la estructura de carpetas oficial -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>xsd-documento-principal</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${dir.xsd.compilacion}/maindoc</outputDirectory>
              <resources>
                <resource>
                  <directory>${dir.xsd.oficial}</directory>
                  <includes>
                    <include>UBL-Invoice-2.1.xsd</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>xsd-componentes-comunes</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${dir.xsd.compilacion}/common</outputDirectory>
              <resources>
                <resource>
                  <directory>${dir.xsd.oficial}</directory>
                  <includes>
                    <include>*.xsd</include>
                  </includes>
                  <excludes>
                    <exclude>UBL-Invoice-2.1.xsd</exclude>
                    <exclude>UBL-CreditNote-2.1.xsd</exclude>
                    <exclude>UBL-DebitNote-2.1.xsd</exclude>
                  </excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Paso 2: xjc convierte UBL-Invoice-2.1.xsd en clases Java en cada compilacion -->
      <plugin>
        <groupId>org.jvnet.jaxb</groupId>
        <artifactId>jaxb-maven-plugin</artifactId>
        <version>4.0.8</version>
        <executions>
          <execution>
            <id>clases-desde-invoice-xsd</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <schemaDirectory>${dir.xsd.compilacion}/maindoc</schemaDirectory>
              <schemaIncludes>
                <include>UBL-Invoice-2.1.xsd</include>
              </schemaIncludes>
              <generateDirectory>${project.build.directory}/generated-sources/xjc</generateDirectory>
              <bindingDirectory>${project.basedir}/src/main/xjc</bindingDirectory>
              <bindingIncludes>
                <include>*.xjb</include>
              </bindingIncludes>
              <strict>false</strict>
              <extension>true</extension>
              <addCompileSourceRoot>true</addCompileSourceRoot>
              <removeOldOutput>true</removeOldOutput>
              <forceRegenerate>true</forceRegenerate>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
