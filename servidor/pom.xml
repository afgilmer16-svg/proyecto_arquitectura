<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pe.abc</groupId>
  <artifactId>facturacion-xml</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Generador XML UBL 2.1 (factura y boleta) - ABC Software Corp</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Los XSD oficiales viven en una sola carpeta del repositorio; se copian a target/ con la
         estructura maindoc/ + common/ que esperan sus schemaLocation (../common/...). -->
    <xsd.origen>${project.basedir}/../docs/referencias/ubl</xsd.origen>
    <xsd.trabajo>${project.build.directory}/xsd-ubl</xsd.trabajo>
    <jacoco.minimo>0.90</jacoco.minimo>
  </properties>

  <dependencies>
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.5</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.2</version>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>1.5.5</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.xmlunit</groupId>
      <artifactId>xmlunit-core</artifactId>
      <version>2.10.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <!-- XSD oficiales con la estructura maindoc/ + common/ (para validar sin red). -->
      <resource><directory>${xsd.trabajo}</directory><targetPath>ubl</targetPath></resource>
      <!-- Contrato de la entrada: se aplica el mismo archivo del repositorio, no una copia. -->
      <resource><directory>${project.basedir}/../specs/schemas</directory><targetPath>schemas</targetPath></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>xsd-maindoc</id>
            <phase>generate-sources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${xsd.trabajo}/maindoc</outputDirectory>
              <resources>
                <resource><directory>${xsd.origen}</directory><includes><include>UBL-Invoice-2.1.xsd</include></includes></resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>xsd-common</id>
            <phase>generate-sources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${xsd.trabajo}/common</outputDirectory>
              <resources>
                <resource>
                  <directory>${xsd.origen}</directory>
                  <includes><include>*.xsd</include></includes>
                  <excludes><exclude>UBL-Invoice-2.1.xsd</exclude><exclude>UBL-CreditNote-2.1.xsd</exclude><exclude>UBL-DebitNote-2.1.xsd</exclude></excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Genera las clases Java desde UBL-Invoice-2.1.xsd en cada compilacion (nada se escribe a mano). -->
      <plugin>
        <groupId>org.jvnet.jaxb</groupId>
        <artifactId>jaxb-maven-plugin</artifactId>
        <version>4.0.8</version>
        <executions>
          <execution>
            <id>xjc-ubl-invoice</id>
            <phase>generate-sources</phase>
            <goals><goal>generate</goal></goals>
            <configuration>
              <schemaDirectory>${xsd.trabajo}/maindoc</schemaDirectory>
              <schemaIncludes><include>UBL-Invoice-2.1.xsd</include></schemaIncludes>
              <generateDirectory>${project.build.directory}/generated-sources/xjc</generateDirectory>
              <bindingDirectory>${project.basedir}/src/main/xjc</bindingDirectory>
              <bindingIncludes><include>*.xjb</include></bindingIncludes>
              <strict>false</strict>
              <extension>true</extension>
              <addCompileSourceRoot>true</addCompileSourceRoot>
              <removeOldOutput>true</removeOldOutput>
              <forceRegenerate>true</forceRegenerate>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <configuration>
          <!-- Las clases generadas por JAXB desde el XSD (oasis, un, org) no son codigo propio. -->
          <excludes>
            <exclude>oasis/**/*</exclude>
            <exclude>un/**/*</exclude>
            <exclude>org/**/*</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <execution>
            <id>reporte</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>minimo</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>${jacoco.minimo}</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
